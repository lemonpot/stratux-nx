[Unit]
Description=Mount persistent ext4 storage for Stratux flight data
DefaultDependencies=no
After=local-fs.target
Before=stratux.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
  if mountpoint -q /overlay/pivot; then \
    mount -o remount,rw /overlay/pivot && \
    mkdir -p /overlay/pivot/opt/stratux-data /opt/stratux-data && \
    { mountpoint -q /opt/stratux-data || mount --bind /overlay/pivot/opt/stratux-data /opt/stratux-data; }; \
  else \
    mkdir -p /opt/stratux-data; \
  fi'

[Install]
WantedBy=multi-user.target
